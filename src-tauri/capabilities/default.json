{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "dialog:default",
    "opener:default",
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "**" }],
      "deny": [
        { "path": "**/*.[eE][xX][eE]" },
        { "path": "**/*.[bB][aA][tT]" },
        { "path": "**/*.[cC][mM][dD]" },
        { "path": "**/*.[cC][oO][mM]" },
        { "path": "**/*.[mM][sS][iI]" },
        { "path": "**/*.[pP][sS]1" },
        { "path": "**/*.[vV][bB][sS]" },
        { "path": "**/*.[lL][nN][kK]" },
        { "path": "**/*.[sS][cC][rR]" },
        { "path": "**/*.[jJ][sS]" },
        { "path": "**/*.[hH][tT][aA]" },
        { "path": "**/*.[vV][bB][eE]" },
        { "path": "**/*.[jJ][sS][eE]" },
        { "path": "**/*.[wW][sS][fF]" },
        { "path": "**/*.[wW][sS][hH]" },
        { "path": "**/*.[cC][pP][lL]" },
        { "path": "**/*.[mM][sS][cC]" },
        { "path": "**/*.[uU][rR][lL]" },
        { "path": "**/*.[aA][pP][pP][rR][eE][fF]-[mM][sS]" },
        { "path": "**/*.[cC][hH][mM]" },
        { "path": "**/*.[pP][iI][fF]" },
        { "path": "**/*.[aA][pP][pP][lL][iI][cC][aA][tT][iI][oO][nN]" },
        { "path": "**/*.[gG][aA][dD][gG][eE][tT]" },
        { "path": "**/*.[mM][sS][pP]" },
        { "path": "**/*.[sS][cC][fF]" },
        { "path": "**/*.[rR][eE][gG]" }
      ]
    },
    "process:default",
    "updater:default"
  ]
}
