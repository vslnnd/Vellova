{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vellova",
  "version": "../package.json",
  "identifier": "com.vslnnd.vellova",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vellova",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": { "resources/tour/*": "tour/" },
    "windows": { "nsis": { "installMode": "currentUser", "installerHooks": "./windows/hooks.nsh" } }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ5QjEwODQwNDNCOERBRTkKUldUcDJyaERRQWl4U2RDWDE1dlJibkJ5a0RXTFZkSEhUSXM0TldkWlJSQXJjVjhSL2UwN205YngK",
      "endpoints": ["https://github.com/vslnnd/Vellova/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
